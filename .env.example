# Copy to .env.local for development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL=postgres://user:password@host:5432/citezeno?sslmode=require

# Random 32+ character secret. Generate one with:  npx @better-auth/cli secret
#   or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public URL of the site (no trailing slash). On Vercel this falls back to
# the production domain if left unset, but setting it is safer.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server console and email
# confirmation is not required, which is handy for local development.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Citezeno <hello@citezeno.com>"
EMAIL_FROM=Citezeno <onboarding@resend.dev>
# Where contact-form messages are delivered
CONTACT_TO=you@example.com

# --- Optional: social sign-in ---------------------------------------------
# Callback URLs to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma-separated (e.g. preview domains)
TRUSTED_ORIGINS=

# --- Credits and billing (Polar) ------------------------------------------
# Free credits every account gets each month (one credit = one claim traced)
NEXT_PUBLIC_FREE_MONTHLY_CREDITS=30
# Organization Access Token from Polar → Settings. Leave empty to turn billing off.
# Scopes: products:read, checkouts:write, customers:read, customers:write,
#         customer_sessions:write, orders:read
POLAR_ACCESS_TOKEN=
# "sandbox" for testing (sandbox.polar.sh), "production" for real payments
POLAR_SERVER=sandbox
# Webhook secret from Polar → Settings → Webhooks. Endpoint:
#   {BETTER_AUTH_URL}/api/auth/polar/webhooks   (events: order.paid, order.refunded)
POLAR_WEBHOOK_SECRET=
# Paid plans. Each plan is two Polar products: one billed monthly, one yearly.
# Paste each product's ID from Polar → Products. Leave an ID empty to hide that option.
# Prices come from Polar; the credits each payment adds come from here.
POLAR_SCHOLAR_MONTHLY_PRODUCT_ID=
POLAR_SCHOLAR_ANNUAL_PRODUCT_ID=
POLAR_LAB_MONTHLY_PRODUCT_ID=
POLAR_LAB_ANNUAL_PRODUCT_ID=
# Credits added per payment (annual plans add the whole year up front)
SCHOLAR_MONTHLY_CREDITS=200
SCHOLAR_ANNUAL_CREDITS=2400
LAB_MONTHLY_CREDITS=1000
LAB_ANNUAL_CREDITS=12000
# Display prices (dollars) shown while a plan isn't set up in Polar yet ("coming soon").
# Once the products exist, the real prices come from Polar instead.
SCHOLAR_MONTHLY_PRICE=7
SCHOLAR_ANNUAL_PRICE=67.20
LAB_MONTHLY_PRICE=19
LAB_ANNUAL_PRICE=182.40

# --- Providers ------------------------------------------------------------
# Which provider does each job (see "Providers" in the README). Leave empty
# for the defaults. Paper providers are comma-separated, primary first.
PAPER_PROVIDERS=
FILE_STORAGE_PROVIDER=
PDF_TEXT_PROVIDER=
# Fetching open-access PDFs for the reader and web pages for the assistant (default "direct-http")
WEB_FILES_PROVIDER=
# Searching the web for the assistant (default "tavily")
WEB_SEARCH_PROVIDER=

# --- Find Papers (OpenAlex) ----------------------------------------------
# Server-only key from https://openalex.org/settings/api (free key = $1/day).
# Never exposed to the browser. Without it, calls share the keyless budget.
OPENALEX_API_KEY=
# Per-call timeout in milliseconds
OPENALEX_TIMEOUT_MS=10000
# Longest search text OpenAlex accepts: 1500 on free keys, up to 2000 on paid plans.
# Longer text is cut at a word break and the user is told.
OPENALEX_MAX_QUERY_CHARS=1500
# Searches each signed-in user may run per day (a Smart search counts as two)
PAPERS_DAILY_SEARCHES=100
# Daily OpenAlex spending (USD): log an alert past the first, stop calling past the second
PAPERS_DAILY_ALERT_USD=0.8
PAPERS_DAILY_CAP_USD=2
# Cache times in seconds: searches (1 day), single papers and related lists (7 days)
PAPERS_CACHE_SEARCH_S=86400
PAPERS_CACHE_PAPER_S=604800

# --- Admin ---------------------------------------------------------------
# Emails that can open /admin (comma-separated). They must confirm the address
# first when email is set up.
ADMIN_EMAILS=

# --- SEO -----------------------------------------------------------------
# Google Search Console -> Add property -> HTML tag: paste only the content="..." value
GOOGLE_SITE_VERIFICATION=

# --- Shelf (Keep Papers) -------------------------------------------------
# Largest PDF a user may upload, in MB
SHELF_PDF_MAX_MB=10
# Total PDF storage per user, in MB
SHELF_STORAGE_MB=500
# PDF uploads per user per day
SHELF_UPLOADS_PER_DAY=50
# Largest .bib / .ris import file, in MB (at most 4.4: Vercel caps request bodies at 4.5 MB)
SHELF_IMPORT_MAX_MB=4
# Most references one import may hold. Imports are worked through in the background, 50 at a time.
SHELF_IMPORT_MAX_ENTRIES=10000
# Secret Vercel Cron sends to /api/shelf/cron (imports, storage clean-up). Any long random string.
CRON_SECRET=
# Tests only: a Postgres URL for the Shelf store tests (they use a throwaway schema).
# Without it those tests are skipped.
# TEST_DATABASE_URL=
# PDF storage: Cloudflare R2 (the default, FILE_STORAGE_PROVIDER=r2). Without these
# four, PDF uploads are switched off with a clear message.
# Cloudflare → R2 → create a private bucket; R2 → Manage API tokens → create a token
# with "Object Read & Write" on that bucket. The bucket also needs a CORS rule so
# browsers can upload and read files (R2 → bucket → Settings → CORS policy):
#   [{"AllowedOrigins":["http://localhost:3000","https://your-domain"],
#     "AllowedMethods":["GET","PUT"],"AllowedHeaders":["content-type","range"],
#     "ExposeHeaders":["content-length","content-range","accept-ranges"],"MaxAgeSeconds":3600}]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a jurisdiction endpoint, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Earlier PDF storage, still supported with FILE_STORAGE_PROVIDER=cloudinary.
# Cloudinary → Settings → API Keys: copy the "API environment variable".
# Also turn on Settings → Security → "Allow delivery of PDF and ZIP files".
CLOUDINARY_URL=
# Recheck saved papers with OpenAlex (citations, retractions) this often, in days, and how many batches of 50 per minute
SHELF_REFRESH_DAYS=7
SHELF_REFRESH_BATCHES=2

# --- AI models (research agent) --------------------------------------------
# Server-only keys. A provider's models are offered only when its key is set.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: an OpenAI-compatible gateway instead of api.openai.com (e.g. https://gateway.example/v1)
OPENAI_BASE_URL=
# Model IDs offered (see lib/providers/chat/models.ts), comma-separated; empty = all
AGENT_MODELS=
# The model new chats start with (default gemini-flash-lite)
AGENT_DEFAULT_MODEL=
# Daily spending per AI provider (USD): alert past the first, stop calling past the second
AI_DAILY_ALERT_USD=5
AI_DAILY_CAP_USD=20
# Most model calls the assistant makes for one message (default 10)
AGENT_MAX_STEPS=10
# Web search for the assistant (the Web switch in the chat's + menu), server only:
# a key from https://app.tavily.com. Without it, the switch says web search isn't set up.
TAVILY_API_KEY=
# What one basic Tavily search costs (USD), for the cost log
TAVILY_USD_PER_SEARCH=0.008
# Daily web search spending (USD): alert past the first, stop searching past the second
WEB_DAILY_ALERT_USD=2
WEB_DAILY_CAP_USD=10

# --- Reader (Read Papers) --------------------------------------------------
# Uses the AI keys above. Without any AI key, papers still open, read and highlight.
# Model for answers and summaries (an ID from lib/providers/chat/models.ts); default: AGENT_DEFAULT_MODEL
READER_MODEL=
# Model for "Explain", follow-up rewriting and section notes; default: the cheapest model on offer
READER_FAST_MODEL=
# Largest paper (in tokens, ~40 pages at 30000) sent to the AI whole instead of searched
READER_FULLTEXT_MAX_TOKENS=30000
# Embeddings for search by meaning (Gemini, GEMINI_API_KEY): see lib/providers/embeddings/models.ts.
# Changing the model re-embeds papers in the background; questions use keyword search meanwhile.
READER_EMBEDDING_MODEL=gemini-embedding-001
# Largest open-access PDF the reader fetches and processes, in MB
READER_PDF_MAX_MB=50
# A stored shared open-access copy nobody opened for this many days is removed (fetched again on the next open)
READER_SHARED_KEEP_DAYS=90
# Background work (text processing) runs from Vercel Cron at /api/reader/cron, with CRON_SECRET.
# Stored vector size, 128–2000 (pgvector indexes up to 2000). Run `npm run db:migrate` after changing it.
READER_EMBEDDING_DIMENSIONS=768
