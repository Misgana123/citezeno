# Copy to .env.local for development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL=postgres://user:password@host:5432/citezeno?sslmode=require

# Random 32+ character secret. Generate one with:  npx @better-auth/cli secret
#   or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public URL of the site (no trailing slash). On Vercel this falls back to
# the production domain if left unset, but setting it is safer.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server console and email
# confirmation is not required, which is handy for local development.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Citezeno <hello@citezeno.com>"
EMAIL_FROM=Citezeno <onboarding@resend.dev>
# Where contact-form messages are delivered
CONTACT_TO=you@example.com

# --- Optional: social sign-in ---------------------------------------------
# Callback URLs to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma-separated (e.g. preview domains)
TRUSTED_ORIGINS=
