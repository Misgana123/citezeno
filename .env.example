# Copy to .env.local for development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL=postgres://user:password@host:5432/citezeno?sslmode=require

# Random 32+ character secret. Generate one with:  npx @better-auth/cli secret
#   or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public URL of the site (no trailing slash). On Vercel this falls back to
# the production domain if left unset, but setting it is safer.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server console and email
# confirmation is not required, which is handy for local development.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Citezeno <hello@citezeno.com>"
EMAIL_FROM=Citezeno <onboarding@resend.dev>
# Where contact-form messages are delivered
CONTACT_TO=you@example.com

# --- Optional: social sign-in ---------------------------------------------
# Callback URLs to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma-separated (e.g. preview domains)
TRUSTED_ORIGINS=

# --- Credits and billing (Polar) ------------------------------------------
# Free credits every account gets each month (one credit = one claim traced)
NEXT_PUBLIC_FREE_MONTHLY_CREDITS=30
# Organization Access Token from Polar → Settings. Leave empty to turn billing off.
# Scopes: products:read, checkouts:write, customers:read, customers:write,
#         customer_sessions:write, orders:read
POLAR_ACCESS_TOKEN=
# "sandbox" for testing (sandbox.polar.sh), "production" for real payments
POLAR_SERVER=sandbox
# Webhook secret from Polar → Settings → Webhooks. Endpoint:
#   {BETTER_AUTH_URL}/api/auth/polar/webhooks   (events: order.paid, order.refunded)
POLAR_WEBHOOK_SECRET=
# Paid plans. Each plan is two Polar products: one billed monthly, one yearly.
# Paste each product's ID from Polar → Products. Leave an ID empty to hide that option.
# Prices come from Polar; the credits each payment adds come from here.
POLAR_SCHOLAR_MONTHLY_PRODUCT_ID=
POLAR_SCHOLAR_ANNUAL_PRODUCT_ID=
POLAR_LAB_MONTHLY_PRODUCT_ID=
POLAR_LAB_ANNUAL_PRODUCT_ID=
# Credits added per payment (annual plans add the whole year up front)
SCHOLAR_MONTHLY_CREDITS=200
SCHOLAR_ANNUAL_CREDITS=2400
LAB_MONTHLY_CREDITS=1000
LAB_ANNUAL_CREDITS=12000
# Display prices (dollars) shown while a plan isn't set up in Polar yet ("coming soon").
# Once the products exist, the real prices come from Polar instead.
SCHOLAR_MONTHLY_PRICE=7
SCHOLAR_ANNUAL_PRICE=67.20
LAB_MONTHLY_PRICE=19
LAB_ANNUAL_PRICE=182.40

# --- Find Papers (OpenAlex) ----------------------------------------------
# Server-only key from https://openalex.org/settings/api (free key = $1/day).
# Never exposed to the browser. Without it, calls share the keyless budget.
OPENALEX_API_KEY=
# Per-call timeout in milliseconds
OPENALEX_TIMEOUT_MS=10000
# Longest search text OpenAlex accepts: 1500 on free keys, up to 2000 on paid plans.
# Longer text is cut at a word break and the user is told.
OPENALEX_MAX_QUERY_CHARS=1500
# Searches each signed-in user may run per day (a Smart search counts as two)
PAPERS_DAILY_SEARCHES=100
# Daily OpenAlex spending (USD): log an alert past the first, stop calling past the second
PAPERS_DAILY_ALERT_USD=0.8
PAPERS_DAILY_CAP_USD=2
# Cache times in seconds: searches (1 day), single papers and related lists (7 days)
PAPERS_CACHE_SEARCH_S=86400
PAPERS_CACHE_PAPER_S=604800

# --- Admin ---------------------------------------------------------------
# Emails that can open /admin (comma-separated). They must confirm the address
# first when email is set up.
ADMIN_EMAILS=

# --- SEO -----------------------------------------------------------------
# Google Search Console -> Add property -> HTML tag: paste only the content="..." value
GOOGLE_SITE_VERIFICATION=
