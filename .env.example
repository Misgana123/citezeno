# Copy to .env.local for development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL=postgres://user:password@host:5432/citezeno?sslmode=require

# Random 32+ character secret. Generate one with:  npx @better-auth/cli secret
#   or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public URL of the site (no trailing slash). On Vercel this falls back to
# the production domain if left unset, but setting it is safer.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server console and email
# confirmation is not required, which is handy for local development.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Citezeno <hello@citezeno.com>"
EMAIL_FROM=Citezeno <onboarding@resend.dev>
# Where contact-form messages are delivered
CONTACT_TO=you@example.com

# --- Optional: social sign-in ---------------------------------------------
# Callback URLs to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma-separated (e.g. preview domains)
TRUSTED_ORIGINS=

# --- Plans, credits and billing (Polar) ----------------------------------
# There is no free plan. Three paid plans (Starter, Scholar, Lab), each billed
# monthly or annually, plus one-off top-ups for plan members. One credit is
# worth $0.01 on every plan. Plan credits expire at the end of each month of
# the plan; annual plans add one month of credits at a time. Top-ups expire
# 12 months after purchase. See docs/creditsystem.md.
#
# Organization Access Token from Polar → Settings. Leave empty to turn billing off
# (the pricing page then shows the plans as "coming soon").
# Scopes: products:read, checkouts:write, customers:read, customers:write,
#         customer_sessions:write, orders:read, subscriptions:read
POLAR_ACCESS_TOKEN=
# "sandbox" for testing (sandbox.polar.sh), "production" for real payments
POLAR_SERVER=sandbox
# Webhook secret from Polar → Settings → Webhooks. Endpoint:
#   {BETTER_AUTH_URL}/api/auth/polar/webhooks
# Events: order.paid, order.refunded, subscription.created, subscription.active,
#   subscription.updated, subscription.canceled, subscription.uncanceled,
#   subscription.revoked, subscription.past_due
POLAR_WEBHOOK_SECRET=
#
# Plans: six recurring Polar products (one monthly and one yearly per plan).
# Paste each product's ID from Polar → Products. Leave an ID empty to hide that option.
# Suggested Polar prices: Starter $7 / $68, Scholar $19 / $183, Lab $39 / $375.
# Allow plan changes (upgrades with proration) in Polar so the portal can switch plans.
POLAR_STARTER_MONTHLY_PRODUCT_ID=
POLAR_STARTER_ANNUAL_PRODUCT_ID=
POLAR_SCHOLAR_MONTHLY_PRODUCT_ID=
POLAR_SCHOLAR_ANNUAL_PRODUCT_ID=
POLAR_LAB_MONTHLY_PRODUCT_ID=
POLAR_LAB_ANNUAL_PRODUCT_ID=
# Credits each plan adds every month (annual plans too, one month at a time)
STARTER_MONTHLY_CREDITS=700
SCHOLAR_MONTHLY_CREDITS=1900
LAB_MONTHLY_CREDITS=3900
# Display prices (dollars) shown while a plan isn't set up in Polar yet ("coming soon").
# Once the products exist, the real prices come from Polar instead.
STARTER_MONTHLY_PRICE=7
STARTER_ANNUAL_PRICE=68
SCHOLAR_MONTHLY_PRICE=19
SCHOLAR_ANNUAL_PRICE=183
LAB_MONTHLY_PRICE=39
LAB_ANNUAL_PRICE=375
#
# Top-ups: three one-time Polar products, only sold to people with a plan.
# Suggested Polar prices: $5, $10, $25.
POLAR_TOPUP_SMALL_PRODUCT_ID=
POLAR_TOPUP_MEDIUM_PRODUCT_ID=
POLAR_TOPUP_LARGE_PRODUCT_ID=
TOPUP_SMALL_CREDITS=500
TOPUP_MEDIUM_CREDITS=1000
TOPUP_LARGE_CREDITS=2500
TOPUP_SMALL_PRICE=5
TOPUP_MEDIUM_PRICE=10
TOPUP_LARGE_PRICE=25
#
# The credits cron (/api/credits/cron, every 5 minutes in vercel.json) settles
# holds nobody finished, expires old credits, adds annual plans' monthly
# credits and emails expiry warnings. It uses CRON_SECRET (see Shelf below).

# --- Providers ------------------------------------------------------------
# Which provider does each job (see "Providers" in the README). Leave empty
# for the defaults. Paper providers are comma-separated, primary first, from:
#   openalex (default), arxiv, pubmed, europepmc, semanticscholar, clinicaltrials
PAPER_PROVIDERS=
FILE_STORAGE_PROVIDER=
PDF_TEXT_PROVIDER=
# Fetching open-access PDFs for the reader and web pages for the assistant (default "direct-http")
WEB_FILES_PROVIDER=
# Searching the web for the assistant (default "tavily")
WEB_SEARCH_PROVIDER=
# Running the assistant's code in a sandbox (default "e2b")
CODE_SANDBOX_PROVIDER=

# --- Optional: Redis ---------------------------------------------------------
# Any Redis (Upstash: the "rediss://" URL from its dashboard; local: redis://localhost:6379).
# When set, the paper services' cache and shared waiting line live in Redis
# (faster, and no load on the database). Without it, or while Redis is down,
# everything stays in Postgres as before.
REDIS_URL=

# --- Paper services: shared settings -------------------------------------------
# Sent to the scholarly services (OpenAlex, Crossref, PubMed…) so they can reach
# us instead of blocking us. Strongly recommended in production.
PROVIDER_CONTACT_EMAIL=
# How long a call may wait its turn in a service's waiting line (ms) before
# the user is told "busy, try again" (default 10000)
PROVIDER_MAX_WAIT_MS=10000

# --- Find Papers (OpenAlex) ----------------------------------------------
# Server-only key from https://openalex.org/settings/api (free key = $1/day).
# Never exposed to the browser. Without it, calls share the keyless budget.
OPENALEX_API_KEY=
# Per-call timeout in milliseconds
OPENALEX_TIMEOUT_MS=10000
# Longest search text OpenAlex accepts: 1500 on free keys, up to 2000 on paid plans.
# Longer text is cut at a word break and the user is told.
OPENALEX_MAX_QUERY_CHARS=1500
# Calls per second to OpenAlex, shared by every server instance (default 10; OpenAlex allows up to 100)
OPENALEX_RATE_PER_S=10

# --- Other paper sources (used only when listed in PAPER_PROVIDERS) -----------
# Every listed source is searched; the first leads. How long a search waits for
# the others (ms) before showing what it has, with a "may be incomplete" note
PAPERS_EXTRA_WAIT_MS=8000
# Per-call timeout for them, in milliseconds
PAPERS_PROVIDER_TIMEOUT_MS=15000
# arXiv: no key. It allows one call every 3 seconds, so keep this at or below 0.33.
ARXIV_RATE_PER_S=0.3
# PubMed: optional free key from https://www.ncbi.nlm.nih.gov/account/ (3 → 10 calls a second)
NCBI_API_KEY=
PUBMED_RATE_PER_S=
# Europe PMC: no key (it allows 10 calls a second)
EUROPEPMC_RATE_PER_S=7
# Semantic Scholar: needs a free key from https://www.semanticscholar.org/product/api
S2_API_KEY=
S2_RATE_PER_S=0.9
# ClinicalTrials.gov: no key, no published limit
CLINICALTRIALS_RATE_PER_S=0.6

# --- Filling in paper details (free PDF links, missing abstracts…) ---------------
# Comma-separated, asked in that order; none by default. From:
#   unpaywall (needs PROVIDER_CONTACT_EMAIL), crossref, core (needs CORE_API_KEY),
#   semanticscholar (needs S2_API_KEY)
PAPER_ENRICHERS=
# Unpaywall allows 100,000 calls a day: our own cap stays below it
UNPAYWALL_RATE_PER_S=5
UNPAYWALL_DAILY_CALLS=90000
# Crossref: 2.5 a second with PROVIDER_CONTACT_EMAIL (its polite pool), else 0.9
CROSSREF_RATE_PER_S=
# CORE: free key from https://core.ac.uk/services/api
CORE_API_KEY=
CORE_RATE_PER_S=0.2
# Searches each signed-in user may run per day (a Smart search counts as two)
PAPERS_DAILY_SEARCHES=100
# Daily OpenAlex spending (USD): log an alert past the first, stop calling past the second
PAPERS_DAILY_ALERT_USD=0.8
PAPERS_DAILY_CAP_USD=2
# Cache times in seconds: searches (1 day), single papers and related lists (7 days)
PAPERS_CACHE_SEARCH_S=86400
PAPERS_CACHE_PAPER_S=604800
# How long expired answers are kept to show while OpenAlex is busy or down (3 days; 0 = never)
PAPERS_CACHE_STALE_S=259200

# --- Find Papers: our own copy of papers -------------------------------------
# "1" keeps a copy of every paper users see (table paper_record) and answers
# single papers from it while fresh, without calling the paper service. Off by default.
PAPERS_LOCAL_COPY=
# How old (days) a kept paper may be and still be served from the copy
PAPERS_LOCAL_FRESH_DAYS=7
# "1" searches the copy first (needs PAPERS_LOCAL_COPY): with at least
# PAPERS_LOCAL_MIN_RESULTS matches, Keyword search is answered from it alone and
# Smart search takes its keyword half from it (the meaning half stays live)
PAPERS_LOCAL_FIRST=
PAPERS_LOCAL_MIN_RESULTS=50
# Filling the copy in the background (/api/papers/cron every 15 minutes, needs
# CRON_SECRET). A source is downloaded only when listed in PAPER_PROVIDERS.
# About 4 KB a paper: 100,000 papers take roughly 400 MB.
# Most-cited OpenAlex papers (all subjects), newest arXiv preprints, newest
# PubMed papers with abstracts (via Europe PMC); 0 turns one off
PAPERS_SEED_OPENALEX=50000
PAPERS_SEED_ARXIV=25000
PAPERS_SEED_EUROPEPMC=25000
# How far back (years) the "newest" downloads go
PAPERS_SEED_YEARS=3
# Once complete, how often (hours) they top up with new papers
PAPERS_SYNC_EVERY_HOURS=12
# Recheck kept papers (citations, retractions) after this many days
PAPERS_LOCAL_REFRESH_DAYS=30
# Papers per run sent to PAPER_ENRICHERS
PAPERS_FILL_BATCH=20
# Limits: past either, the least-seen papers are removed first
PAPERS_LOCAL_MAX_ROWS=150000
PAPERS_LOCAL_MAX_MB=500

# --- Admin ---------------------------------------------------------------
# Emails that can open /admin (comma-separated). They must confirm the address
# first when email is set up.
ADMIN_EMAILS=

# --- SEO -----------------------------------------------------------------
# Google Search Console -> Add property -> HTML tag: paste only the content="..." value
GOOGLE_SITE_VERIFICATION=

# --- Shelf (Keep Papers) -------------------------------------------------
# Largest PDF a user may upload, in MB
SHELF_PDF_MAX_MB=10
# Total PDF storage per user, in MB
SHELF_STORAGE_MB=500
# PDF uploads per user per day
SHELF_UPLOADS_PER_DAY=50
# Largest .bib / .ris import file, in MB (at most 4.4: Vercel caps request bodies at 4.5 MB)
SHELF_IMPORT_MAX_MB=4
# Most references one import may hold. Imports are worked through in the background, 50 at a time.
SHELF_IMPORT_MAX_ENTRIES=10000
# Secret Vercel Cron sends to /api/shelf/cron (imports, storage clean-up). Any long random string.
CRON_SECRET=
# Tests only: a Postgres URL for the Shelf store tests (they use a throwaway schema).
# Without it those tests are skipped.
# TEST_DATABASE_URL=
# PDF storage: Cloudflare R2 (the default, FILE_STORAGE_PROVIDER=r2). Without these
# four, PDF uploads are switched off with a clear message.
# Cloudflare → R2 → create a private bucket; R2 → Manage API tokens → create a token
# with "Object Read & Write" on that bucket. The bucket also needs a CORS rule so
# browsers can upload and read files (R2 → bucket → Settings → CORS policy):
#   [{"AllowedOrigins":["http://localhost:3000","https://your-domain"],
#     "AllowedMethods":["GET","PUT"],"AllowedHeaders":["content-type","range"],
#     "ExposeHeaders":["content-length","content-range","accept-ranges"],"MaxAgeSeconds":3600}]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a jurisdiction endpoint, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Earlier PDF storage, still supported with FILE_STORAGE_PROVIDER=cloudinary.
# Cloudinary → Settings → API Keys: copy the "API environment variable".
# Also turn on Settings → Security → "Allow delivery of PDF and ZIP files".
CLOUDINARY_URL=
# Recheck saved papers with OpenAlex (citations, retractions) this often, in days, and how many batches of 50 per minute
SHELF_REFRESH_DAYS=7
SHELF_REFRESH_BATCHES=2

# --- AI models (research agent) --------------------------------------------
# Server-only keys. OpenRouter serves the models (its live list, hundreds of
# models from many makers) and the embeddings; Gemini, called directly, stands
# in while OpenRouter is down. With only GEMINI_API_KEY, Gemini's own models are offered.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Models offered, comma-separated: IDs, or a maker's models with "*"
# (e.g. google/*,anthropic/*,openai/gpt-6-luna); empty = every model
AGENT_MODELS=
# The model new chats start with (default google/gemini-3.5-flash-lite)
AGENT_DEFAULT_MODEL=
# Models shown first in the picker under "Popular", in order: IDs or names as shown
# (e.g. Claude Sonnet 5.5, openai/gpt-6.2-sol); default: POPULAR_MODELS in
# lib/providers/chat/models.ts); every model is still listed below under "All"
AGENT_POPULAR_MODELS=
# The direct Gemini model (lib/providers/chat/models.ts) that answers for other makers'
# models while OpenRouter is down (default google/gemini-3.5-flash-lite)
AI_FALLBACK_MODEL=
# Daily spending per AI provider (USD; OpenRouter and Gemini each): alert past the first, stop calling past the second
AI_DAILY_ALERT_USD=5
AI_DAILY_CAP_USD=20
# Most model calls the assistant makes for one message (default 10)
AGENT_MAX_STEPS=10
# Web search for the assistant (the Web switch in the chat's + menu), server only:
# a key from https://app.tavily.com. Without it, the switch says web search isn't set up.
TAVILY_API_KEY=
# What one basic Tavily search costs (USD), for the cost log
TAVILY_USD_PER_SEARCH=0.008
# Daily web search spending (USD): alert past the first, stop searching past the second
WEB_DAILY_ALERT_USD=2
WEB_DAILY_CAP_USD=10
# Running Python for the assistant (run_python) in an E2B sandbox, server only:
# a key from https://e2b.dev. Without it, the assistant says running code isn't set up.
E2B_API_KEY=
# Optional: a custom E2B template (e.g. one with LibreOffice for file conversion)
E2B_TEMPLATE=
# What a running sandbox costs (USD per second), for the cost log: E2B's default
# 2 vCPU + 4 GiB at $0.000014 per vCPU-second and $0.0000045 per GiB-second
E2B_USD_PER_SECOND=0.000046
# "off" cuts the sandbox off from the internet (default on)
CODE_SANDBOX_INTERNET=
# Daily sandbox spending (USD): alert past the first, stop running code past the second
CODE_DAILY_ALERT_USD=2
CODE_DAILY_CAP_USD=10

# --- Reader (Read Papers) --------------------------------------------------
# Uses the AI keys above. Without any AI key, papers still open, read and highlight.
# Model for answers and summaries (a model ID on offer, e.g. google/gemini-3.5-flash); default: AGENT_DEFAULT_MODEL
READER_MODEL=
# Model for "Explain", follow-up rewriting and section notes; default: READER_MODEL
READER_FAST_MODEL=
# Largest paper (in tokens, ~40 pages at 30000) sent to the AI whole instead of searched
READER_FULLTEXT_MAX_TOKENS=30000
# Embeddings for search by meaning: see lib/providers/embeddings/models.ts. The default,
# google/gemini-embedding-2, goes through OpenRouter, and straight to Gemini when OpenRouter
# is down or has no key (same vectors). Changing the model re-embeds papers in the background;
# questions use keyword search meanwhile.
READER_EMBEDDING_MODEL=google/gemini-embedding-2
# Largest open-access PDF the reader fetches and processes, in MB
READER_PDF_MAX_MB=50
# A stored shared open-access copy nobody opened for this many days is removed (fetched again on the next open)
READER_SHARED_KEEP_DAYS=90
# Background work (text processing) runs from Vercel Cron at /api/reader/cron, with CRON_SECRET.
# Stored vector size, 128–2000 (pgvector indexes up to 2000). Run `npm run db:migrate` after changing it.
READER_EMBEDDING_DIMENSIONS=768

# --- Optional: connected apps ---------------------------------------------------
# Users connect their own accounts in Settings → Customize → Connectors. Their tokens are
# sealed in the database with this secret (32+ random characters, e.g.
# `openssl rand -base64 32`). Without it, connecting apps is off. Changing it
# means everyone connects their apps again. Run `npm run db:migrate` once.
CONNECTORS_SECRET=
# Google Drive, Docs and Sheets reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above
# unless these are set. Add {BETTER_AUTH_URL}/api/connectors/google/callback as an
# authorized redirect URI and enable the Drive, Sheets and Picker APIs. Only the
# drive.file scope is asked for (files the user picks), so no security assessment is needed.
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
# For the Google file picker: a browser API key restricted to the Picker API and
# your site, and the Cloud project's number (IAM & Admin → Settings)
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Notion: a public integration (notion.so/my-integrations), redirect URI
# {BETTER_AUTH_URL}/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Zotero: register an app at zotero.org/oauth/apps (free, instant), callback
# {BETTER_AUTH_URL}/api/connectors/zotero/callback, for "Sign in with Zotero".
# Without these, users connect Zotero by pasting an API key.
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
# Google Calendar: the same Google client as Drive. Add
# {BETTER_AUTH_URL}/api/connectors/google-calendar/callback as another redirect URI and
# enable the Calendar API. Its scopes are "sensitive": submit the consent screen for
# Google's (free) verification; until then only test users can connect.
# Microsoft 365 (Outlook mail and calendar, OneDrive): an app registration in Microsoft
# Entra for any organization and personal accounts, web redirect URI
# {BETTER_AUTH_URL}/api/connectors/microsoft/callback, a client secret, and delegated
# permissions offline_access, User.Read, Mail.ReadWrite, Calendars.ReadWrite,
# Files.ReadWrite. Mail is drafts only (no Mail.Send). Do publisher verification (free,
# with a Microsoft Partner ID) so universities see a verified app.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# GitHub: a GitHub App (not the sign-in OAuth app above). Callback URL
# {BETTER_AUTH_URL}/api/connectors/github/callback, "Expire user authorization tokens"
# on; permissions Contents read, Issues read and write, Pull requests read, Metadata read.
# The slug is the app's URL name (github.com/apps/<slug>), for "Choose repositories".
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Slack: a Slack app with user token scopes search:read, channels:read, groups:read,
# channels:history, groups:history, users:read, chat:write, and redirect URL
# {BETTER_AUTH_URL}/api/connectors/slack/callback. Until it's approved in the Slack
# Marketplace (free review), reading history is limited to 15 messages a minute.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Todoist: an app in Todoist's App Management console, OAuth redirect URL
# {BETTER_AUTH_URL}/api/connectors/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Linear: an OAuth application (Linear settings → API), callback URL
# {BETTER_AUTH_URL}/api/connectors/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
